# Copy this file to .env and edit the values for your host.
# Never commit .env: it may contain private tokens or credentials.

# Unraid defaults. For a standard Linux host, use the paths in docs/installation.md.
APPDATA_ROOT=/mnt/user/appdata
DATA_ROOT=/mnt/user/data

# LinuxServer.io containers. Unraid commonly uses 99:100.
# On Linux, obtain your IDs with: id <your-user>
PUID=99
PGID=100
TZ=Asia/Bahrain

# Optional: paste a Plex claim token from https://www.plex.tv/claim/
PLEX_CLAIM=

# Published host ports (change the left side if a port is already in use).
PLEX_PORT=32400
SEERR_PORT=5055
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENT_PORT=6881
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
